<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9C9FFF"
    tools:context=".MainActivity">


    <Spinner
        android:id="@+id/mySpinner"
        android:layout_width="291dp"
        android:layout_height="wrap_content"
        android:background="@color/cardview_light_background"
        android:padding="10dp"
        android:pointerIcon="arrow"
        android:spinnerMode="dialog"
        tools:layout_editor_absoluteX="58dp"
        tools:layout_editor_absoluteY="136dp" />

    <SeekBar
        android:id="@+id/seekBar"
        style="@style/Widget.AppCompat.SeekBar.Discrete"
        android:layout_width="259dp"
        android:layout_height="wrap_content"
        android:max="200"
        android:min="1"
        android:progress="200"
        tools:layout_editor_absoluteX="38dp"
        tools:layout_editor_absoluteY="276dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="test text"
        android:textSize="60sp"
        tools:layout_editor_absoluteX="88dp"
        tools:layout_editor_absoluteY="414dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your dog is fatter than"
        tools:layout_editor_absoluteX="136dp"
        tools:layout_editor_absoluteY="379dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="of dogs of the same breed"
        tools:layout_editor_absoluteX="123dp"
        tools:layout_editor_absoluteY="513dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonFemale"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Female"
        tools:layout_editor_absoluteX="205dp"
        tools:layout_editor_absoluteY="203dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:checkedButton="@+id/buttonMale"
        app:selectionRequired="true"
        app:singleSelection="true"
        tools:layout_editor_absoluteX="117dp"
        tools:layout_editor_absoluteY="178dp">

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FatDog"
        android:textSize="50dp"
        tools:layout_editor_absoluteX="126dp"
        tools:layout_editor_absoluteY="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonMale"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Male"
        tools:layout_editor_absoluteX="117dp"
        tools:layout_editor_absoluteY="203dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        tools:layout_editor_absoluteX="315dp"
        tools:layout_editor_absoluteY="275dp" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Made by Cooper Provins, Spring 2026"
        tools:layout_editor_absoluteX="88dp"
        tools:layout_editor_absoluteY="696dp" />

</androidx.constraintlayout.widget.ConstraintLayout>